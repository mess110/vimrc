#!/bin/bash

# These should work
#
# app-image-runner WowUp-CF-2.20.0.AppImage
# app-image-runner ~/.local/bin/WowUp-CF-2.20.0.AppImage
# app-image-runner --latest WowUp

function run_it() {
  echo "Running $1"
  # $1 is the AppImage path, ${@:2} are the remaining arguments
  exec "$1" --no-sandbox "${@:2}"
}

function run_latest() {
  local prefix="$1"
  # Find files starting with $prefix and ending in AppImage, sort them, and take the last one
  local latest_app
  latest_app=$(ls -1v ~/.local/bin/"$prefix"*AppImage 2>/dev/null | tail -n 1)

  if [ -n "$latest_app" ]; then
    run_it "$latest_app" "${@:2}"
  else
    echo "No $prefix AppImage found in ~/.local/bin/"
    exit 1
  fi
}

if [ $# -eq 0 ]; then
  echo "No arguments supplied"
  exit 1
fi

if [ "$1" = "--latest" ]; then
  if [ $# -lt 2 ]; then
    echo "No prefix supplied for --latest"
    exit 1
  fi
  run_latest "${@:2}"
  exit 0
fi

# Check if the first argument is a valid file
if [ ! -f "$1" ]; then
  # If not a file, check if it's a command in the system PATH
  path_of_input=$(which "$1")
  if [ $? -eq 0 ]; then
    # Replace $1 with the full path, then pass all arguments to run_it
    set -- "$path_of_input" "${@:2}"
    run_it "$@"
    exit 0
  fi
  echo "File not found: $1"
  exit 1
fi

# If it is a file, just run it with all original arguments
run_it "$@"
