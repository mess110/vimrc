#!/bin/bash
# shell script to replace i3status

function write_to_disk() {
  echo $TIME_NOW >$CMD_FILE_PATH
  eval $CMD >>$CMD_FILE_PATH
}

function read_from_disk() {
  OUTPUT=$(sed -e 1d $CMD_FILE_PATH)
  echo $OUTPUT
}

function api_disk_cache() {
  if (($# != 3)); then
    echo "Usage: $(basename $0) $1 expire_seconds 'command'" >&2
    exit 1
  fi

  EXPIRE_SECONDS=$2
  CMD=$3
  CMD_HASH=$(echo -n "$CMD" | md5sum | awk '{print $1}')
  CMD_FILE_PATH="$HOME/.$CMD_HASH"

  if [ ! -f $CMD_FILE_PATH ]; then
    write_to_disk
  else
    LAST_EXECUTE_TIME=$(head -n 1 $CMD_FILE_PATH)
    RUNTIME=$((TIME_NOW - LAST_EXECUTE_TIME))

    if [ "$RUNTIME" -gt "$EXPIRE_SECONDS" ]; then
      write_to_disk
    fi
  fi

  read_from_disk
}

function hour_to_icon() {
  hour=$(date +"%I")
  case $hour in
  01)
    hour_icon="🕐"
    ;;
  02)
    hour_icon="🕑"
    ;;
  03)
    hour_icon="🕒"
    ;;
  04)
    hour_icon="🕓"
    ;;
  05)
    hour_icon="🕔"
    ;;
  06)
    hour_icon="🕕"
    ;;
  07)
    hour_icon="🕖"
    ;;
  08)
    hour_icon="🕗"
    ;;
  09)
    hour_icon="🕘"
    ;;
  10)
    hour_icon="🕙"
    ;;
  11)
    hour_icon="🕚"
    ;;
  12)
    hour_icon="🕛"
    ;;
  *)
    hour_icon="?$hour?"
    ;;
  esac
  echo $hour_icon
}

lock() {
  CUSTOM_I3LOCK=~/vimrc/forks/i3lock/build/i3lock

  if [ -x "$CUSTOM_I3LOCK" ]; then
    "$CUSTOM_I3LOCK" \
      --nofork \
      --ignore-empty-password \
      --image ~/vimrc/images/yamato.png \
      --color=17181b \
      --indicator-idle-fill-color=2E1A24 \
      --indicator-idle-stroke-color=5FD3D0 \
      --indicator-key-active-color=7DE0D3 \
      --indicator-backspace-active-color=D8482A \
      --indicator-wrong-color=7A3540 \
      --indicator-wrong-stroke-color=3D3789 \
      --indicator-verifying-fill-color=3D3789 \
      --indicator-verifying-stroke-color=5FD3D0 \
      --indicator-failed-attempts-color=E8C468
  else
    i3lock --nofork --ignore-empty-password --color=17181b --image ~/vimrc/images/yamato.png
  fi
}

enableautolock() {
  xset s on s blank s 600
  xset +dpms dpms 600 600 600
  i3-msg "exec xautolock -time 10 -locker \"$1 lock\" -detectsleep"
}

disableautolock() {
  pkill xautolock 2>/dev/null
  xset s off && xset -dpms && xset s noblank
}

toggleautolock() {
  if xset q | grep -q "DPMS is Enabled"; then
    disableautolock
  else
    enableautolock "$1"
  fi
}

showautolock() {
  if xset q | grep -q "DPMS is Enabled"; then
    echo ''
  else
    echo '🔓'
  fi
}

zenity_notification() {
  which zenity >/dev/null && zenity --notification --text=$1
}

rofi() {
  CUSTOM_ROFI=~/vimrc/forks/rofi/build/rofi

  if [ -x "$CUSTOM_ROFI" ]; then
    "$CUSTOM_ROFI" -show drun
  else
    command rofi -show drun
  fi
}

togglelayout() {
  layout=$(setxkbmap -query | grep layout | awk '{print $2}')
  if [ "$layout" = "us" ]; then
    setxkbmap ro
    zenity_notification "ro"
  else
    setxkbmap us
    zenity_notification "us"
  fi
}

calendar() {
  zenity --calendar
}

homeConfiguration() {
  monitor1="DisplayPort-0"
  monitor2="HDMI-A-0"

  configuration=${1-single}
  case $configuration in
  single)
    xrandr --auto
    xrandr --output $monitor2 --off
    ;;
  multiple)
    xrandr --auto
    xrandr --output $monitor1 --left-of $monitor2
    xrandr --output $monitor2 --rotate left --pos 1920x-400
    ;;
  *)
    echo "Unknown configuration $configuration"
    ;;
  esac
}

workConfiguration() {
  monitor1="HDMI-1"
  monitor2="eDP-1"
  monitor3="VGA-1"

  configuration=${1-single}
  case $configuration in
  single)
    xrandr --auto
    xrandr --output $monitor1 --off
    ;;
  multiple)
    xrandr --auto
    xrandr --output $monitor3 --left-of $monitor1
    xrandr --output $monitor2 --off
    ;;
  all)
    xrandr --auto
    xrandr --output $monitor3 --left-of $monitor1
    xrandr --output $monitor2 --right-of $monitor1
    ;;
  *)
    echo "Unknown configuration $configuration"
    ;;
  esac
}

monitors_old() {
  xrandr --listmonitors | grep DisplayPort-0
  greprc=$?

  if [[ $greprc -eq 0 ]]; then
    homeConfiguration $1
  else
    workConfiguration $1
  fi
}

monitors() {
  monitor1="DP-2"
  monitor2="HDMI-0"

  configuration=${1-main}
  case $configuration in
  main)
    xrandr \
      --output $monitor2 --off \
      --output $monitor1 --mode 2560x1440 --rate 75 --primary &&
      zenity_notification "main"
    ;;
  secondary)
    xrandr \
      --output $monitor1 --off \
      --output $monitor2 --mode 1920x1080 --primary &&
      zenity_notification "secondary"
    ;;
  clone)
    xrandr \
      --auto \
      --output $monitor1 --mode 1920x1080 --primary --same-as $monitor2 &&
      zenity_notification "clone"
    ;;
  both)
    xrandr \
      --output $monitor1 --mode 2560x1440 --rate 75 --primary \
      --output $monitor2 --mode 1920x1080 --right-of $monitor1 &&
      zenity_notification "both"
    ;;
  *)
    echo "Unknown configuration $configuration"
    ;;
  esac

}

TIME_NOW=$(date "+%s")

case "$1" in
lock)
  lock
  ;;
calendar)
  calendar
  ;;
monitors)
  monitors "$2"
  ;;
hourtoicon)
  hour_to_icon
  ;;
toggleautolock)
  toggleautolock "$0"
  ;;
enableautolock)
  enableautolock "$0"
  ;;
disableautolock)
  disableautolock
  ;;
showautolock)
  showautolock
  ;;
togglelayout)
  togglelayout
  ;;
rofi)
  rofi
  ;;
logout)
  i3-msg exit
  ;;
suspend)
  lock && systemctl suspend
  ;;
hibernate)
  lock && systemctl hibernate
  ;;
reboot)
  systemctl reboot
  ;;
shutdown)
  systemctl poweroff
  ;;
api-disk-cache)
  api_disk_cache "$1" "$2" "$3"
  ;;
*)
  echo "Usage: $0 {lock|calendar|monitors|hourtoicon|toggleautolock|enableautolock|disableautolock|showautolock|togglelayout|rofi|logout|suspend|hibernate|reboot|shutdown|api-disk-cache}"
  exit 2
  ;;
esac

exit 0
